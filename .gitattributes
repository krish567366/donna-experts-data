*.parquet filter=lfs diff=lfs merge=lfs -text
# Defense in depth: corpus PDFs are ignored by .gitignore and belong in object
# storage. If an operator intentionally force-adds one, store an LFS pointer
# instead of placing the binary in ordinary Git history.
phsycology/corpus/**/*.pdf filter=lfs diff=lfs merge=lfs -text

*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
